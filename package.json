{
  "name": "artfreq-ad",
  "version": "1.0.0",
  "description": "ArtFreq ad, hook A: a 28-second vertical video composed with HyperFrames from footage filmed from the real plug-in",
  "scripts": {
    "lint": "hyperframes lint",
    "check": "hyperframes check --no-cache",
    "render": "hyperframes render --fps 30 --quality delivery --crf 14 --keyframe-interval 2 --video-frame-format png --strict -o ad-artfreq-hookA.mp4"
  },
